<configuration name="xml_curl.conf" description="Fetch SIP and dialplan configuration from the fax2email app">
  <bindings>
    <binding name="fax2email">
      <param name="gateway-url" value="http://127.0.0.1/freeswitch/xml" bindings="configuration|dialplan"/>
      <param name="gateway-credentials" value="$${xml_curl_credentials}"/>
      <param name="auth-scheme" value="basic"/>
      <param name="timeout" value="10"/>
      <param name="disable-100-continue" value="true"/>
    </binding>
  </bindings>
</configuration>
