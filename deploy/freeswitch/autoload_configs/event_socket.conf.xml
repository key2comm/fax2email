<configuration name="event_socket.conf" description="Control port used by the fax2email app">
  <settings>
    <!-- Local only; the app uses it to reload trunks and read their status. -->
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="$${esl_password}"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>
