<?xml version="1.0"?>
<!--
  fax2email's FreeSWITCH configuration. Installed to /etc/freeswitch.
  SIP profiles, trunks, the trunk ACL and the dialplan are not stored here:
  FreeSWITCH fetches them from the fax2email app through mod_xml_curl, so
  changes made in the portal apply without editing files.
  vars.xml (secrets) is generated by the installer and kept on updates.
-->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="include" data="vars.xml"/>

  <section name="configuration" description="Module configuration">
    <X-PRE-PROCESS cmd="include" data="autoload_configs/*.xml"/>
  </section>

  <!-- Filled in by mod_xml_curl from the app. -->
  <section name="dialplan" description="Dialplan"/>
  <section name="directory" description="No SIP users: calls only come from trunks"/>
</document>
